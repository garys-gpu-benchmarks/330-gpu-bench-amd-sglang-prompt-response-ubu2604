  {
    "field_name": "Raw Output Example",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "request_id,sample_index,status,input_tokens,output_tokens,end_to_end_latency_ms,ttft_ms,output_tokens_per_s,completed_request_rate_pct,radixattention_cache_hit_rate_pct,prompt_tokens,cached_tokens,error_message\n0,0,ok,128,32,400,40,80,100,0,128,0,"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --dtype bfloat16 --input-len 64 --output-len 16 --num-prompts 2 --seed 42 --streaming true"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --dtype bfloat16 --input-len 512 --output-len 750 --num-prompts 8 --seed 42 --streaming true"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --extended --validate --dtype bfloat16 --input-len 1024 --output-len 5270 --num-prompts 8 --seed 42 --streaming true"
  },
  {
    "field_name": "Output Fields / Metrics to Parse",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "end_to_end_latency_ms, ttft_ms, output_tokens_per_s, completed_request_rate_pct, radixattention_cache_hit_rate_pct"
  },
  {
    "field_name": "Success Criteria",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "server readiness succeeds and at least one request completes; successful rows have finite positive end_to_end_latency_ms and, when streaming, TTFT <= end-to-end latency. Failed requests lower completed_request_rate_pct; the run fails only if every request fails"
  },
  {
    "field_name": "Parser and Normalization Notes",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Locked overlay parse_results.py. Means use successful requests only. output_tokens_per_s is the decode rate, (output tokens - 1) / (end-to-end - TTFT); output tokens are the server's usage.completion_tokens, else the streamed text-chunk count. RadixAttention hit rate = total cached prompt tokens / total prompt tokens over successful requests (usage.prompt_tokens_details.cached_tokens, returned with --enable-cache-report); prompts share a common first half by design, so about 50% is expected once warm. completed_request_rate_pct = successful / attempted requests. Unmeasured values read na (reason): no cached counts (smoke server), no streaming (TTFT and decode rate), request failed"
  },
